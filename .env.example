# RecoverAI – Environment Configuration
# Copy this file to .env and adjust values.

DEMO_MODE=true
SECRET_KEY=change-me
DATABASE_URL=sqlite:///recoverai_demo.db
CORS_ORIGINS=*

# Payment provider: "demo" (default) or "razorpay" (optional).
# The demo provider requires NO external API keys.
PAYMENT_PROVIDER=demo

# PostgreSQL (optional – SQLite works for demo):
# DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5432/recoverai

# Gemini API (optional – demo agent works without it):
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Razorpay (optional – only needed when PAYMENT_PROVIDER=razorpay):
# Sign up at https://dashboard.razorpay.com and generate Test Mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
